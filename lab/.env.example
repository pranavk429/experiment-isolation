# Example only. lab/bootstrap.py generates the real lab/.env with mode 600.
# Never commit a filled-in copy. Load with: source lab/.env
#
# export LAB_API_URL=http://localhost:8010
# export LAB_ADMIN_EMAIL=admin@isolation-lab.local
# export LAB_ADMIN_PASSWORD=<generated>
# export LAB_ADMIN_TOKEN=<generated>
# export LAB_ORG_ID=1
# export LAB_ORG_NAME="Experiment Isolation Lab"
# export LAB_PROJECT_ID=1
# export LAB_PROJECT_NAME="Isolation Storefront"
# export LAB_DEV_ENV_ID=1
# export LAB_DEV_ENV_KEY=<generated>
# export LAB_PROD_ENV_ID=2
# export LAB_PROD_ENV_KEY=<generated>
# export LAB_ADMIN_API_KEY=<generated>
#
# Engine / Flagsmith CLI compatibility:
# export FLAGSMITH_API_URL=http://localhost:8010
# export FLAGSMITH_API_KEY=<generated admin key>
# export FLAGSMITH_API_KEY_localhost_8010=<generated admin key>
# export FLAGSMITH_ENVIRONMENT_KEY=<generated dev key>
# export DEV_ENV_KEY=<generated dev key>
# export PROD_ENV_KEY=<generated prod key>
# export FLAGSMITH_PROJECT="Isolation Storefront"
